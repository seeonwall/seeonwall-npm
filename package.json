{
  "name": "seeonwall",
  "version": "0.2.0",
  "description": "Show shoppers a poster on their own wall, at true scale. The seeonwall.com widget for React and headless storefronts.",
  "keywords": [
    "seeonwall",
    "poster",
    "wall-art",
    "product-visualization",
    "ecommerce",
    "headless-commerce",
    "shopify",
    "hydrogen",
    "storefront"
  ],
  "license": "MIT",
  "author": "Mateusz Dziurdziak",
  "homepage": "https://seeonwall.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seeonwall/seeonwall-npm.git"
  },
  "bugs": {
    "url": "https://github.com/seeonwall/seeonwall-npm/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
